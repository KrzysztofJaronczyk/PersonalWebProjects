<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Forest - pełna oferta</title>
	<link rel="icon" type="image/png" sizes="32x32" href="/dist/img/tree.svg">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@100;300;400;500;700;900&display=swap"
		rel="stylesheet">
	<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300..800&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="./dist/css/style.min.css">
</head>

<body id="home">
	<!-- @include '_nav.kit' -->

	<main>
		<div class="wrapper__small padd-5">
			<h2 class="section-title">Nasza pełna oferta</h2>
			<div class="cards-container cards-container--big">
				<div class="card">
					<div class="card__title">Demo</div>
					<div class="card__price"><span>$</span>0</div>
					<div class="card__text">
						<p class="card__text__item">
							<img src="dist/img/check.svg" alt="Check icon" class="icon" /> opcja w pakiecie
						</p>
						<p class="card__text__item">
							<img src="dist/img/check.svg" alt="Check icon" class="icon" /> opcja w pakiecie
						</p>
						<p class="card__text__item card__text__item--disabled">
							<img src="dist/img/minus.svg" alt="Check icon" class="icon" /> opcja poza pakietem
						</p>
						<p class="card__text__item card__text__item--disabled">
							<img src="dist/img/minus.svg" alt="Check icon" class="icon" /> opcja poza pakietem
						</p>
						<p class="card__text__item card__text__item--disabled">
							<img src="dist/img/minus.svg" alt="Check icon" class="icon" /> opcja poza pakietem
						</p>
					</div>
					<button class="card__btn">Wybierz</button>

				</div>
				<div class="card">
					<div class="card__title">Standard</div>
					<div class="card__price"><span>$</span>99</div>
					<div class="card__text">
						<p class="card__text__item">
							<img src="dist/img/check.svg" alt="Check icon" class="icon" /> opcja w pakiecie
						</p>
						<p class="card__text__item">
							<img src="dist/img/check.svg" alt="Check icon" class="icon" /> opcja w pakiecie
						</p>
						<p class="card__text__item">
							<img src="dist/img/check.svg" alt="Check icon" class="icon" /> opcja w pakiecie
						</p>
						<p class="card__text__item card__text__item--disabled">
							<img src="dist/img/minus.svg" alt="Check icon" class="icon" /> opcja poza pakietem
						</p>
						<p class="card__text__item card__text__item--disabled">
							<img src="dist/img/minus.svg" alt="Check icon" class="icon" /> opcja poza pakietem
						</p>
					</div>
					<button class="card__btn card__btn--active">Wybierz</button>
				</div>
				<div class="card">
					<div class="card__title">Premium</div>
					<div class="card__price"><span>$</span>299</div>
					<div class="card__text">
						<p class="card__text__item">
							<img src="dist/img/check.svg" alt="Check icon" class="icon" /> opcja w pakiecie
						</p>
						<p class="card__text__item">
							<img src="dist/img/check.svg" alt="Check icon" class="icon" /> opcja w pakiecie
						</p>
						<p class="card__text__item">
							<img src="dist/img/check.svg" alt="Check icon" class="icon" /> opcja w pakiecie
						</p>
						<p class="card__text__item">
							<img src="dist/img/check.svg" alt="Check icon" class="icon" /> opcja w pakiecie
						</p>
						<p class="card__text__item">
							<img src="dist/img/check.svg" alt="Check icon" class="icon" /> opcja w pakiecie
						</p>
					</div>
					<button class="card__btn">Wybierz</button>
				</div>
				<div class="card">
					<div class="card__title">MAXX</div>
					<div class="card__price"><span>$</span>399</div>
					<div class="card__text">
						<p class="card__text__item">
							<img src="dist/img/check.svg" alt="Check icon" class="icon" /> wszystko co w wersji Premium
						</p>
						<p class="card__text__item">
							<img src="dist/img/check.svg" alt="Check icon" class="icon" /> wsparcie 24/7
						</p>
					</div>
					<button class="card__btn">Wybierz</button>
				</div>
				<div class="card">
					<div class="card__title">ULTIMATE</div>
					<div class="card__price"><span>$</span>499</div>
					<div class="card__text">
						<p class="card__text__item">
							<img src="dist/img/check.svg" alt="Check icon" class="icon" /> wszystko co w wersji Premium
						</p>
						<p class="card__text__item">
							<img src="dist/img/check.svg" alt="Check icon" class="icon" /> wsparcie 24/7
						</p>
						<p class="card__text__item">
							<img src="dist/img/check.svg" alt="Check icon" class="icon" /> własny opiekun klienta
						</p>
						<p class="card__text__item">
							<img src="dist/img/check.svg" alt="Check icon" class="icon" /> dostęp do beta testów
						</p>
					</div>
					<button class="card__btn">Wybierz</button>
				</div>
			</div>


		</div>
	</main>
	<!-- @include '_footer.kit' -->


</body>
<script src="./dist/js/navbar.min.js"></script>
<script src="/dist/js/pageTheme.min.js"></script>
<script src="/dist/js/footerYear.min.js"></script>


</html>